{
  "version": 5,
  "configurePresets": [
    { "name": "windows", "generator": "Visual Studio 18 2026", "architecture": "x64", "binaryDir": "${sourceDir}/out/windows", "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" } },
    { "name": "macos", "generator": "Unix Makefiles", "binaryDir": "${sourceDir}/out/macos", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }, "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" } }
  ],
  "buildPresets": [
    { "name": "windows-debug", "configurePreset": "windows", "configuration": "Debug" },
    { "name": "macos-debug", "configurePreset": "macos" }
  ],
  "testPresets": [
    { "name": "windows-debug", "configurePreset": "windows", "configuration": "Debug", "output": { "outputOnFailure": true } },
    { "name": "macos-debug", "configurePreset": "macos", "output": { "outputOnFailure": true } }
  ]
}
