{
  "tasks": [
    {
      "problemMatcher": [
        "$msCompile"
      ],
      "label": "(Windows) Compiler",
      "type": "process",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "isDefault": false,
        "kind": "build"
      },
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/compiler-windows.ps1"
      ]
    },
    {
      "problemMatcher": [
        "$msCompile"
      ],
      "label": "(Windows) Vérifier",
      "type": "process",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/compiler-windows.ps1",
        "-Verifier"
      ]
    },
    {
      "type": "cppbuild",
      "label": "C/C++: cl.exe build active file",
      "command": "cl.exe",
      "args": [
        "/Zi",
        "/EHsc",
        "/nologo",
        "/Fe${fileDirname}\\${fileBasenameNoExtension}.exe",
        "${file}"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": [
        "$msCompile"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "Task generated by Debugger."
    }
  ],
  "version": "2.0.0"
}