{
  "tasks": [
    {
      "problemMatcher": [
        "$msCompile"
      ],
      "label": "(Windows) Compiler",
      "type": "process",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "isDefault": true,
        "kind": "build"
      },
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/compiler-windows.ps1"
      ]
    },
    {
      "problemMatcher": [
        "$msCompile"
      ],
      "label": "(Windows) Vérifier",
      "type": "process",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/compiler-windows.ps1",
        "-Verifier"
      ]
    }
  ],
  "version": "2.0.0"
}
